<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            padding: 40px;
        }

        .container {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        h1 {
            color: #333;
        }

        .user {
            padding: 15px;
            margin: 10px 0;
            background-color: #eeeeee;
            border-radius: 6px;
        }

        .total {
            margin-top: 20px;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>User List</h1>

        <% if (users.length === 0) { %>

            <p>No users available.</p>

        <% } else { %>

            <% users.forEach((user, index) => { %>

                <div class="user">
                    <strong><%= index + 1 %>. <%= user.name %></strong>
                    <br>
                    Email: <%= user.email %>
                    <br>
                    Age: <%= user.age %> years
                </div>

            <% }); %>

            <div class="total">
                Total users: <%= users.length %>
            </div>

        <% } %>

    </div>

</body>
</html>